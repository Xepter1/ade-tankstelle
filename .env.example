# ============================================================
#  Kontaktformular – SMTP-Zugangsdaten
#  Kopiere diese Datei nach ".env" und trage echte Werte ein:
#     cp .env.example .env
#  Die .env-Datei NICHT ins Git/öffentliche Repo legen!
# ============================================================

# SMTP-Server des Mailproviders (z. B. der Domain tankstelle-stettner.de)
SMTP_HOST=mail.example.de
SMTP_PORT=587
# true = Port 465 (SSL), false = Port 587 (STARTTLS)
SMTP_SECURE=false

# Postfach-Zugangsdaten
SMTP_USER=info@tankstelle-stettner.de
SMTP_PASS=hier-das-postfach-passwort

# Absender- und Empfängeradresse der Formular-Mails
MAIL_FROM=info@tankstelle-stettner.de
MAIL_TO=info@tankstelle-stettner.de
